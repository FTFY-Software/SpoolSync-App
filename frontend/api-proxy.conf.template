# Optional second listener, mounted by compose/lan-api-shared.yml: serves the
# backend API on port 3000 of this container, so ESP32 spool holders can use
# the web UI's address when the stack has a single LAN IP.
server {
    listen 3000;
    server_name _;

    location / {
        proxy_pass http://${BACKEND_HOST}:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Proxy WebSocket
    location /socket.io/ {
        proxy_pass http://${BACKEND_HOST}:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
