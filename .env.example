# ─────────────────────────────────────────────────────────────────────────────
# SpoolSync configuration
#
# Copy to .env and edit, or run ./install.sh to generate it interactively.
# Docker Compose reads this file automatically from the project directory.
# Full reference: docs/CONFIGURATION.md
#
# Values are single-quoted so Compose does not interpolate `$` inside them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required secrets ─────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32

# Password for the bundled PostgreSQL database. Only applied when the database
# volume is first created; changing it later requires changing it inside
# Postgres too (see docs/CONFIGURATION.md). Use URL-safe characters only:
# A-Z a-z 0-9 . _ ~ -
POSTGRES_PASSWORD='change_me_in_production'

# Signs login sessions. Use 32+ random characters. Changing it logs everyone out.
JWT_SECRET='change_this_to_a_long_random_secret_in_production'

# ── Hostnames & addresses ────────────────────────────────────────────────────
# Name or IP people use to reach SpoolSync. Informational (wizard output).
SPOOLSYNC_HOSTNAME=''
# Public base URL behind a reverse proxy, e.g. https://spoolsync.example.com.
# Fixes the OIDC callback URL; empty = derive it from each request.
PUBLIC_URL=''
# Default host/IP the ESP32 provisioning dialog gives to spool holders.
# Empty = the hostname in the browser's address bar. An IP is safest.
ESP32_SERVER_HOST=''

# ── Network ──────────────────────────────────────────────────────────────────
# Host interface for the web UI: 0.0.0.0 = all, 127.0.0.1 = local reverse
# proxy only, or one of this host's IPs.
FRONTEND_BIND='0.0.0.0'
# Host port for the web UI (nginx serves the SPA and proxies /api to backend).
FRONTEND_PORT='80'

# Host interface for the backend API. ESP32 spool holders talk to the backend
# directly, so keep it reachable from your LAN if you use them.
# 127.0.0.1 hides the API from the network (breaks ESP32 devices).
BACKEND_BIND='0.0.0.0'
# Host port for the backend API.
BACKEND_PORT='3000'

# ── LAN networking (macvlan/ipvlan) ──────────────────────────────────────────
# Alternative to host ports: SpoolSync gets fixed addresses on an existing
# Docker LAN network. One address: compose/lan-network.yml +
# compose/lan-api-shared.yml (UI on :80, API on :3000 of FRONTEND_LAN_IP).
# Two addresses: compose/lan-network.yml + compose/lan-backend.yml with
# BACKEND_LAN_IP. See docs/CONFIGURATION.md → LAN networking.
SPOOLSYNC_NETWORK_MODE='host'
LAN_NETWORK='lan'
FRONTEND_LAN_IP=''
BACKEND_LAN_IP=''

# ── Database ─────────────────────────────────────────────────────────────────
# Connection used by the backend. Defaults target the bundled container.
# For an external server, set these and add compose/external-db.yml to
# COMPOSE_FILE (see below).
POSTGRES_HOST='postgres'
POSTGRES_PORT='5432'
# Name/user of the database. For the bundled container these are only
# applied when the volume is first created.
POSTGRES_DB='spoolsync'
POSTGRES_USER='spoolsync'

# Publish the bundled database on the host (requires compose/publish-db.yml
# in COMPOSE_FILE). 127.0.0.1 keeps it local to this host.
POSTGRES_PUBLISH_BIND='127.0.0.1'
POSTGRES_PUBLISH_PORT='5432'

# Optional overlays. Setting COMPOSE_FILE disables automatic loading of
# docker-compose.override.yml, so list it last if you use one.
# COMPOSE_FILE='docker-compose.yml:compose/external-db.yml'
# COMPOSE_FILE='docker-compose.yml:compose/publish-db.yml'
# COMPOSE_FILE='docker-compose.yml:compose/lan-network.yml:compose/lan-api-shared.yml'
# COMPOSE_PATH_SEPARATOR=':'

# ── Sessions ─────────────────────────────────────────────────────────────────
# Local-login session lifetime (e.g. 12h, 7d, 30d). OIDC sessions are always 7d.
JWT_EXPIRES_IN='7d'

# ── Printers ─────────────────────────────────────────────────────────────────
# How often printers are polled for job status, in milliseconds.
PRINTER_POLL_INTERVAL_MS='30000'

# Optional syslog destination pushed to PrusaLink "buddy" firmware printers
# during auto-configuration (host or host:port). Leave empty to skip.
SYSLOG_HOST=''

# Optional Browserless (headless Chrome) WebSocket endpoint used for the
# work-in-progress PrusaConnect login, e.g. ws://browserless:3000
BROWSERLESS_URL=''

# ── Images ───────────────────────────────────────────────────────────────────
# Tag for ghcr.io/spool-sync/* images when pulling instead of building.
SPOOLSYNC_TAG='latest'
